<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KonSolTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#0D1724</item>
        <item name="android:navigationBarColor">#0D1724</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#4CB3FF</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- FR-05: four weighted columns; captions ellipsize, never overlap. -->
    <style name="MacroButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
    </style>
</resources>
