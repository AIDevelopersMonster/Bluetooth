{
  "schema_version": 1,
  "id": "jdy31",
  "title": "JDY-31A V2.241 (SPP + BLE)",
  "baud": 9600,
  "ending": "CRLF",
  "timeout_ms": 800,
  "verified_reads": false,
  "notes": "PHYSICAL: JDY-31A-V2.241, Classic 3.0 + BLE, UART 9600 8N1 CRLF. AT+NAME returned +NAME=? and phone now advertises '?'; CAUSATION NOT YET ESTABLISHED. AT+NAME is quarantined for a controlled one-command investigation only, NEVER sent by Read core, snapshots or inspection. 4 automatic baseline reads: VERSION, LADDR, BAUD, PIN. Other [PROBE] candidates unverified. No setters, SLEEP, RESET, DISC or DEFAULT. Breakout VCC 3.6-6V, UART 3.3V.",
  "reference": "https://fccid.io/2AXM8-JDY-33/User-Manual/15-JDY-33-UserMan-US-r2-4936883.pdf",
  "queries": [
    {
      "id": "version",
      "label": "Firmware version",
      "command": "AT+VERSION",
      "prefix": "+VERSION="
    },
    {
      "id": "address",
      "label": "Bluetooth MAC (reported)",
      "command": "AT+LADDR",
      "prefix": "+LADDR="
    },
    {
      "id": "name",
      "label": "[CAUTION] Bluetooth name",
      "command": "AT+NAME",
      "prefix": "+NAME=",
      "unknown_values": [
        "?"
      ],
      "probe_only": true
    },
    {
      "id": "baud",
      "label": "UART baud index",
      "command": "AT+BAUD",
      "prefix": "+BAUD="
    },
    {
      "id": "pin",
      "label": "Pairing PIN (private)",
      "command": "AT+PIN",
      "prefix": "+PIN="
    },
    {
      "id": "at_ping",
      "label": "[PROBE] AT ping",
      "command": "AT",
      "prefix": "",
      "probe_only": true
    },
    {
      "id": "enlog",
      "label": "[PROBE] UART event output",
      "command": "AT+ENLOG",
      "prefix": "+ENLOG=",
      "probe_only": true
    },
    {
      "id": "stat",
      "label": "[PROBE] Connection state",
      "command": "AT+STAT",
      "prefix": "+STAT=",
      "probe_only": true
    },
    {
      "id": "ble_name",
      "label": "[PROBE] BLE advertised name",
      "command": "AT+NAMB",
      "prefix": "+NAME=",
      "probe_only": true
    },
    {
      "id": "type",
      "label": "[PROBE] SPP password mode",
