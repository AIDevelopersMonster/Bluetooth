      "command": "AT+VERSION",
      "prefix": "+VERSION="
    },
    {
      "id": "address",
      "label": "Bluetooth MAC (reported)",
      "command": "AT+LADDR",
      "prefix": "+LADDR="
    },
    {
      "id": "name",
